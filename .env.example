# Required
ACTUAL_SERVER_URL=http://actualbudget:5006
ACTUAL_SERVER_PASSWORD=
ACTUAL_SYNC_ID=
ACTUAL_VENMO_ACCOUNT_ID=

# Optional
# Pre-trusted device-id from a browser session. See README "Troubleshooting → OAuth2 Exception".
# VENMO_DEVICE_ID=

# Optional (defaults shown)
SYNC_CRON=0 4 * * *
INITIAL_BACKFILL_DAYS=30
IMPORT_PENDING=true
SYNC_ON_BOOT=false
DATA_DIR=/data
ACTUAL_CACHE_DIR=/app/actual-cache
LOG_LEVEL=info
TZ=UTC
